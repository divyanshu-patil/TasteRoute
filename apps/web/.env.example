# Copy to .env.local for local dev; on Vercel set these in the project's environment variables.
# NEXT_PUBLIC_ values are built into the browser bundle: only public values here, never a secret key.

# The TasteRoute API (FastAPI). Default: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional sign-in with Google and "Send with Gmail" (F12). Leave empty to hide login.
# Supabase project URL and its publishable (anon) key: Project Settings -> API Keys. Never the sb_secret_ key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shown on /privacy and /terms as the contact for questions and deletion requests. Optional.
NEXT_PUBLIC_CONTACT_EMAIL=

# Google Search Console -> URL-prefix property -> HTML tag: the content="..." value. Proves the site is yours. Optional.
GOOGLE_SITE_VERIFICATION=
