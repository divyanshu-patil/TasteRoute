# Copy to apps/api/.env and fill in. Never commit .env.
APP_ENV=development
SESSION_SECRET=generate-a-long-random-string
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://localhost:5432/tasteroute
# DB_STATEMENT_CACHE_SIZE=0   # when using the Supabase transaction pooler

QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

LLM_PROVIDER=ollama_cloud        # or "fake" for offline demos and tests
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b

HUNTER_API_KEY=                  # optional; contacts work without it
OSM_USER_AGENT=TasteRoute/0.1 (contact: you@example.com)

DEMO_MODE_ENABLED=true
DEMO_RUN_ID=
PUBLIC_RUNS_PER_IP_PER_DAY=3     # live runs per visitor per 24 h; 0 = no limit (local only)
